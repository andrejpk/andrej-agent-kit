# Copy to .env beside script.py. Use your existing resource's custom endpoint.
# Sign in separately with az login --tenant <tenant-id>.
AZURE_SPEECH_AUTH=cli
AZURE_SPEECH_ENDPOINT=https://<custom-name>.cognitiveservices.azure.com/

# Optional legacy mode, only where your organization permits API keys:
# AZURE_SPEECH_AUTH=key
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
